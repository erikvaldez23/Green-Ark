{
  "name": "green-ark",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "postbuild": "react-snap",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "reactSnap": {
    "source": "dist",
    "puppeteerExecutablePath": "/Applications/Google Chrome.app/Contents/MacOS/Google Chrome",
    "puppeteerArgs": [
      "--no-sandbox",
      "--disable-setuid-sandbox"
    ],
    "inlineCss": true,
    "minifyHtml": {
      "collapseWhitespace": true
    },
    "routes": [
      "/",
      "/properties",
      "/property/1",
      "/property/2",
      "/property/3",
      "/property/4",
      "/property/5",
      "/property/6",
      "/property/7",
      "/property/8",
      "/blog/1",
      "/blog/2",
      "/blog/3",
      "/blog/4",
      "/blog/5",
      "/blog/6",
      "/blog/7",
      "/blog/8",
      "/about",
      "/blogs",
      "/contact",
      "/gallery",
      "/ark-crypto",
      "/ark-os"
    ]
  },
  "dependencies": {
    "lottie-react": "^2.4.1",
    "lottie-web": "^5.13.0",
    "lucide-react": "^0.562.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-helmet-async": "^3.0.0",
    "react-router-dom": "^7.13.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "react-snap": "^1.23.0",
    "vite": "npm:rolldown-vite@7.2.5"
  },
  "overrides": {
    "vite": "npm:rolldown-vite@7.2.5"
  }
}
